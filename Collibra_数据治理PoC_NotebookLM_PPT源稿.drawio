<mxfile host="app.diagrams.net" modified="2026-03-25T00:00:00.000Z" agent="Cursor" version="22.1.0" type="device">
  <diagram id="CollibraPoC_NotebookLM" name="Collibra PoC NotebookLM 叙事图">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="t1" value="Collibra Data Governance PoC&#xa;NotebookLM 风格汇报（结论先行 + 证据驱动）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="520" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="对象：[管理层/项目委员会]  |  日期：[填写日期]" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="400" y="72" width="520" height="24" as="geometry"/>
        </mxCell>

        <!-- 0 TL;DR -->
        <mxCell id="n0" value="0) TL;DR&#xa;• 4周 PoC（私有化/只读/抽样/不出内网）&#xa;• 验证：加载·识别·清洗·校验&#xa;• 交付：现状报告·路线图·预算·验收&#xa;• 开源对照：OpenMetadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="280" height="100" as="geometry"/>
        </mxCell>

        <!-- 1 Why now -->
        <mxCell id="n1" value="1) Why now&#xa;• ERP/HR/SRM 异构&#xa;• 主数据不一致、对账成本高&#xa;• 合规：只读·审计·不外发&#xa;• 缺持续治理机制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="240" height="100" as="geometry"/>
        </mxCell>

        <!-- 2 命题 ABCD -->
        <mxCell id="n2a" value="命题A 可见性&#xa;可信目录（表/字段/键/注释/Owner）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n2b" value="命题B 可追溯性&#xa;跨系统关系·关键血缘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="890" y="120" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n2c" value="命题C 可运营性&#xa;质量闭环（识别·派单·修复·复跑）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1060" y="120" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n2d" value="命题D 可合规性&#xa;私有化内网·只读稳定运行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1240" y="120" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- 3 范围边界 -->
        <mxCell id="n3" value="3) 范围与边界&#xa;系统：ERP·HR·SRM（首批）&#xa;数据：主数据+事务结构/样本+元数据&#xa;技术：只读·最小权限·抽样剖析&#xa;不做：全量入仓·生产自动改库·越权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="260" width="300" height="110" as="geometry"/>
        </mxCell>

        <!-- 4 方法 4步 -->
        <mxCell id="n4" value="4) Machine First, Human in Control&#xa;① 自动采集（连接器·结构元数据）&#xa;② 自动候选（关系/血缘候选）&#xa;③ 人工确认（业务+IT·置信度）&#xa;④ 闭环运营（工单·复跑·规则迭代）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="260" width="320" height="110" as="geometry"/>
        </mxCell>

        <!-- 5 4周 -->
        <mxCell id="n5" value="5) 4周执行计划&#xa;W1 环境·安全·连接·首次采集&#xa;W2 关系/血缘候选与联合确认&#xa;W3 质量规则·主数据一致性&#xa;W4 演示·价值·验收·路线图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="260" width="300" height="110" as="geometry"/>
        </mxCell>

        <!-- 6-9 四问 -->
        <mxCell id="n6" value="6) 数据加载&#xa;层1：元数据+剖析→治理平台&#xa;层2：全量入仓→数仓/ETL（后续）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1120" y="260" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="7) 问题识别&#xa;规则+画像+对账 → 清单&#xa;质量工单平台化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="410" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="8) 自动清洗&#xa;≠ 无审批改生产库&#xa;识别·建议·派单·复核&#xa;改数：源系统/MDM/ETL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="410" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="9) 效果校验&#xa;复跑差异·指标改善·抽检签字·防复发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="410" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- 10-14 -->
        <mxCell id="n10" value="10) 安全与合规&#xa;内网·只读·不全量搬运·留痕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="410" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="11) RACI&#xa;Sponsor / 治理 / Owner&#xa;IT·DBA / 实施方" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="960" y="410" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="12) PoC 验收标准&#xa;三系统接入·覆盖阈值·血缘确认&#xa;闭环问题数·合规满足" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="410" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="13) 价值量化&#xa;效率·质量·风险·管理 KPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="530" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="14) 风险与缓释&#xa;审批慢·参与不足·识别偏差·预期过高" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="530" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- 15-18 -->
        <mxCell id="n15" value="15) 商业 vs 开源&#xa;Collibra：一体化治理运营&#xa;OpenMetadata：成本·私有化灵活&#xa;共识：内网·只读·可审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="520" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="16) 3/6/12 月路线图&#xa;0-3：目录·术语·Owner·规则·工单&#xa;3-6：主数据深化·血缘完善&#xa;6-12：扩系统·常态化 KPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="520" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="17) 本次会议请拍板&#xa;启动 PoC · 冻结验收 · 组织责任&#xa;并行开源对照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1180" y="520" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="18) 结束页&#xa;先 PoC 拿证据 → 再规模化&#xa;救火式 → 经营式数据治理&#xa;Q&amp;A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="640" width="360" height="90" as="geometry"/>
        </mxCell>

